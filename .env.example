# Copy to .env and enter your local password there. Never share .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cpp_system
MYSQL_USER=cpp_app
MYSQL_PASSWORD=

# Demo APPLICATION passwords, different from the MySQL password.
# Set locally before running seed_demo.py; 12-72 UTF-8 bytes, distinct values.
DEMO_STUDENT_PASSWORD=
DEMO_COUNSELOR_PASSWORD=
